<?xml version="1.0" encoding="UTF-8"?>

<!-- REGISTRO HISTORICO: demanda calibrada antiga, com motos contadas como carros.
     Mesma rede e mesmos detectores do Cruzamento.sumocfg; muda apenas o
     arquivo de rotas, que usa a demanda calibrada pelos videos de drone.
     Ver o cabecalho de Cruzamento.calibrated-motos.rou.xml. -->

<sumoConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="Cruzamento.net.xml"/>
        <route-files value="Cruzamento.calibrated-motos.rou.xml"/>
        <additional-files value="Cruzamento.add.xml"/>
    </input>

</sumoConfiguration>
